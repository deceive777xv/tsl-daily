---
type IconName =
  | 'archive'
  | 'arrow-left'
  | 'arrow-right'
  | 'close'
  | 'code'
  | 'external'
  | 'info'
  | 'pause'
  | 'play'
  | 'reset';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg aria-hidden="true" class="icon" fill="none" height={size} viewBox="0 0 24 24" width={size}>
  {name === 'archive' && <path d="M4 7.5h16v12H4zM3 4h18v3.5H3zM9 11h6" />}
  {name === 'arrow-left' && <path d="m15 18-6-6 6-6" />}
  {name === 'arrow-right' && <path d="m9 18 6-6-6-6" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'code' && <path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14" />}
  {name === 'external' && <path d="M14 5h5v5M19 5l-8 8M18 13v6H5V6h6" />}
  {name === 'info' && <path d="M12 17v-6M12 7.5v.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />}
  {name === 'pause' && <path d="M9 7v10M15 7v10" />}
  {name === 'play' && <path d="m9 7 8 5-8 5Z" />}
  {name === 'reset' && <path d="M5 8V4m0 0h4M5 4l3.2 3.2A7 7 0 1 1 6 15" />}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }
</style>
